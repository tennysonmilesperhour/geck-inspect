      "destination": "/MorphVisualizer",
      "permanent": true
    },
    {
      "source": "/morphguide",
      "destination": "/MorphGuide",
      "permanent": true
    },
    {
      "source": "/morphguide/:slug",
      "destination": "/MorphGuide/:slug",
      "permanent": true
    },
    {
      "source": "/morphguide/category/:categoryId",
