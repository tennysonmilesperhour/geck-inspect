    },
    {
      "source": "/morphvisualizer",
      "destination": "/MorphVisualizer",
      "permanent": true
    },
    {
      "source": "/marketplace",
      "destination": "/Marketplace",
      "permanent": true
    },
    {
      "source": "/marketplacebuy",
      "destination": "/MarketplaceBuy",
      "permanent": true
    },
    {
      "source": "/marketplaceverification",
      "destination": "/MarketplaceVerification",
      "permanent": true
    },
    {
      "source": "/gallery",
      "destination": "/Gallery",
      "permanent": true
    },
    {
      "source": "/forum",
      "destination": "/Forum",
      "permanent": true
    },
    {
      "source": "/communityconnect",
      "destination": "/CommunityConnect",
