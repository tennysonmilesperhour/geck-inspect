    },
    {
      "source": "/careguide",
      "destination": "/CareGuide",
      "permanent": true
    },
    {
      "source": "/careguide/:topic",
      "destination": "/CareGuide/:topic",
      "permanent": true
    },
    {
      "source": "/geneticsguide",
      "destination": "/GeneticsGuide",
      "permanent": true
    },
    {
      "source": "/geneticcalculatortool",
      "destination": "/calculator",
      "permanent": true
    },
    {
      "source": "/GeneticCalculatorTool",
      "destination": "/calculator",
