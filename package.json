    "heic-to": "1.6.6",
    "html-to-image": "1.11.13",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.475.0",
    "posthog-js": "^1.438.9",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
