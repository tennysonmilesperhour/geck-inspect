    "backfill:morph-embeddings": "node scripts/backfill-morph-embeddings.mjs",
    "audit:strict": "node scripts/seo-audit.mjs --strict",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p ./jsconfig.json",
    "preview": "vite preview",
    "cap:sync": "pnpm build && cap sync",
    "cap:open:android": "cap open android",
    "android:debug": "pnpm cap:sync && cd android && ./gradlew assembleDebug",
    "android:release": "GECK_RELEASE_TARGET=android pnpm cap:sync && cd android && ./gradlew bundleRelease",
    "cap:open:ios": "cap open ios",
    "ios:release": "GECK_RELEASE_TARGET=ios pnpm cap:sync && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
