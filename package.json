{
  "name": "geck-inspect",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.6",
      "@humanfs/node": "0.16.8",
      "@ungap/structured-clone": "1.4.0",
      "@xmldom/xmldom": "0.9.12",
