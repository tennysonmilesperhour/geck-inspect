    "build:content-dates": "node scripts/build-content-dates.mjs",
    "build:sitemap": "node scripts/build-sitemap.mjs",
    "build:llms-full": "node scripts/build-llms-full.mjs",
    "build:agent-data": "node scripts/build-agent-data.mjs",
    "build:mcp": "node scripts/build-mcp.mjs",
    "build:morphs-csv": "node scripts/build-morphs-csv.mjs",
    "build:vercel-json": "node scripts/build-vercel-json.mjs",
    "submit:indexnow": "node scripts/submit-indexnow.mjs",
    "build:pdfs": "node scripts/generate-pdfs.mjs",
    "build:analytics-demo": "node scripts/build-analytics-demo.mjs",
    "build:prerender": "node scripts/prerender.mjs",
    "audit": "node scripts/seo-audit.mjs",
    "check:genetics": "node scripts/check-genetics-consistency.mjs",
