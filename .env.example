# Public build-time variables for the Vite bundle. Anything prefixed
# VITE_ ends up in the shipped JavaScript, so only publishable keys go
# here. Secrets (Stripe secret key, service role key, Anthropic key)
# live on the Supabase edge functions, never in this file.
#
# Local dev: copy to .env.local and fill in. Production: set the same
# names under Vercel, Settings, Environment Variables, Production. A
# build prints which of these it found (names only) as [check-env]
# lines at the top of the Vercel build log.

# Supabase project (required)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# RevenueCat Web Billing public key (required in production).
# rcb_... is production, rcb_sb_... or test_... is sandbox. Without this
# production builds fail. Only development has a Test Store fallback.
VITE_REVENUECAT_WEB_API_KEY=

# PostHog product analytics (required in production, phc_...). Without
# it every captureEvent call is a no-op and the funnel is invisible.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Web push (required in production). The public half of the VAPID pair;
# the private half is a Supabase function secret.
VITE_VAPID_PUBLIC_KEY=

# Optional integrations
# Set to 1 only once the Supabase plan includes image transformations.
VITE_IMAGE_TRANSFORMS=
VITE_GECK_DATA_SUPABASE_URL=
VITE_GECK_DATA_SUPABASE_ANON_KEY=
VITE_MARKET_SNAPSHOT_URL=
VITE_MARKET_INTEL_URL=
VITE_SHIPZEROS_LIVE=

# Native store SDK public keys, required for the respective release target.
# IOS is appl_..., Android is goog_... . These are separate from Web Billing.
VITE_REVENUECAT_IOS_API_KEY=
VITE_REVENUECAT_ANDROID_API_KEY=

# Release evidence gates. Set only after completing docs/BILLING.md and
# docs/ENGINEERING.md device checks; these are not browser variables.
NATIVE_BILLING_WEBHOOK_VERIFIED=
NATIVE_AUTH_REDIRECT_VERIFIED=
