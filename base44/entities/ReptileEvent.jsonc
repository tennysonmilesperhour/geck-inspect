{
  "name": "ReptileEvent",
  "type": "object",
  "properties": {
    "reptile_id": {
      "type": "string",
      "description": "ID of the reptile this event is for"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "shed",
        "feeding",
        "defecation",
        "cage_cleaning",
        "bug_feeding",
        "custom"
      ],
      "description": "Type of event"
    },
    "custom_event_name": {
      "type": "string",
      "description": "Name of custom event if event_type is custom"
    },
    "event_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the event occurred"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes about the event"
    }
  },
  "required": [
    "reptile_id",
    "event_type",
    "event_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "created_by": "{{user.email}}"
    }
  }
}