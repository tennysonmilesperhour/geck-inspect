{
  "name": "MorphReferenceImage",
  "type": "object",
  "properties": {
    "morph_guide_id": {
      "type": "string",
      "description": "The ID of the MorphGuide entry this image is for."
    },
    "image_url": {
      "type": "string",
      "description": "URL of the user-submitted image."
    },
    "submitted_by_email": {
      "type": "string",
      "description": "Email of the user who submitted the photo."
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "Approval status of the submitted image."
    },
    "rejection_reason": {
      "type": "string",
      "description": "Reason for rejection, if applicable."
    }
  },
  "required": [
    "morph_guide_id",
    "image_url",
    "submitted_by_email",
    "status"
  ],
  "rls": {
    "read": {},
    "write": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}