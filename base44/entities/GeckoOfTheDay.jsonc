{
  "name": "GeckoOfTheDay",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "description": "The date this gecko was featured"
    },
    "gecko_image_id": {
      "type": "string",
      "description": "ID of the featured GeckoImage"
    },
    "appreciative_message": {
      "type": "string",
      "description": "The generated appreciative message about the gecko"
    },
    "uploader_email": {
      "type": "string",
      "description": "Email of the user who uploaded the featured gecko"
    },
    "notification_sent": {
      "type": "boolean",
      "default": false,
      "description": "Whether notification was sent to the uploader"
    }
  },
  "required": [
    "date",
    "gecko_image_id",
    "appreciative_message",
    "uploader_email"
  ],
  "rls": {
    "read": {},
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}