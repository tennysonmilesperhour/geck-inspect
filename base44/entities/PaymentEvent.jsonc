{
  "name": "PaymentEvent",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the user this payment event belongs to"
    },
    "stripe_customer_id": {
      "type": "string",
      "description": "Stripe customer ID associated with this event"
    },
    "stripe_event_id": {
      "type": "string",
      "description": "Unique Stripe event ID (evt_...) for deduplication"
    },
    "stripe_subscription_id": {
      "type": "string",
      "description": "Stripe subscription ID if applicable (sub_...)"
    },
    "stripe_invoice_id": {
      "type": "string",
      "description": "Stripe invoice ID if applicable (in_...)"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "subscription_created",
        "subscription_updated",
        "subscription_canceled",
        "subscription_past_due",
        "subscription_trial_start",
        "payment_succeeded",
        "payment_failed",
        "refund_issued",
        "chargeback_opened",
        "chargeback_resolved"
      ],
      "description": "Type of Stripe payment event"
    },
    "amount_cents": {
      "type": "number",
      "description": "Amount in cents (e.g. 999 = $9.99)"
    },
    "currency": {
      "type": "string",
      "default": "usd",
      "description": "ISO currency code"
    },
    "membership_tier": {
      "type": "string",
      "enum": [
        "free",
        "keeper",
        "breeder"
      ],
      "description": "Membership tier associated with this event"
    },
    "billing_cycle": {
      "type": "string",
      "enum": [
        "monthly",
        "annual"
      ],
      "description": "Billing cycle at time of event"
    },
    "status": {
      "type": "string",
      "enum": [
        "succeeded",
        "failed",
        "pending",
        "refunded",
        "disputed"
      ],
      "description": "Outcome status of this payment event"
    },
    "failure_reason": {
      "type": "string",
      "description": "Stripe failure message if payment failed"
    },
    "raw_stripe_payload": {
      "type": "string",
      "description": "Full raw JSON payload from Stripe webhook, stored as string for audit purposes"
    },
    "event_timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "When this event occurred according to Stripe"
    }
  },
  "required": [
    "user_email",
    "stripe_event_id",
    "event_type",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}