{
  "name": "FeedingGroup",
  "type": "object",
  "properties": {
    "label": {
      "type": "string",
      "description": "Short label for the group (e.g., A, B, C)"
    },
    "name": {
      "type": "string",
      "description": "Descriptive name for the group"
    },
    "diet_type": {
      "type": "string",
      "description": "What they are fed (e.g., Repashy CGD, Pangea, Crickets)"
    },
    "interval_days": {
      "type": "number",
      "description": "How many days between feedings"
    },
    "last_fed_date": {
      "type": "string",
      "format": "date",
      "description": "Date this group was last fed"
    },
    "color": {
      "type": "string",
      "description": "Hex color code for display"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes about this feeding group"
    },
    "auto_weight_min_g": {
      "type": "number",
      "description": "Minimum weight (grams) for automatic gecko inclusion. Geckos in this range are auto-assigned."
    },
    "auto_weight_max_g": {
      "type": "number",
      "description": "Maximum weight (grams) for automatic gecko inclusion. Geckos in this range are auto-assigned."
    }
  },
  "required": [
    "label",
    "diet_type",
    "interval_days"
  ],
  "rls": {
    "read": {
      "created_by": "{{user.email}}"
    },
    "write": {
      "created_by": "{{user.email}}"
    }
  }
}