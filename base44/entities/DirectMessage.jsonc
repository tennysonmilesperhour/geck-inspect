{
  "name": "DirectMessage",
  "type": "object",
  "properties": {
    "sender_email": {
      "type": "string",
      "description": "Email of the user who sent the message"
    },
    "recipient_email": {
      "type": "string",
      "description": "Email of the user who should receive the message"
    },
    "content": {
      "type": "string",
      "description": "The message content"
    },
    "is_read": {
      "type": "boolean",
      "default": false,
      "description": "Whether the message has been read by the recipient"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "direct",
        "system"
      ],
      "default": "direct",
      "description": "Type of message"
    }
  },
  "required": [
    "sender_email",
    "recipient_email",
    "content"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "sender_email": "{{user.email}}"
        },
        {
          "recipient_email": "{{user.email}}"
        }
      ]
    },
    "create": {
      "$or": [
        {
          "sender_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "sender_email": "{{user.email}}"
        },
        {
          "recipient_email": "{{user.email}}"
        }
      ]
    }
  }
}