{
  "name": "CareGuideSection",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Title of the care guide section"
    },
    "content": {
      "type": "string",
      "description": "The main content/text of the section"
    },
    "order_position": {
      "type": "number",
      "description": "Order position for displaying sections"
    },
    "category": {
      "type": "string",
      "enum": [
        "housing",
        "feeding",
        "handling",
        "breeding",
        "health",
        "general"
      ],
      "description": "Category this section belongs to"
    },
    "image_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Images associated with this section"
    },
    "is_published": {
      "type": "boolean",
      "default": true,
      "description": "Whether this section is visible to users"
    },
    "source_url": {
      "type": "string",
      "description": "URL of source material if auto-generated"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time",
      "description": "When this section was last updated"
    }
  },
  "required": [
    "title",
    "content",
    "category",
    "order_position"
  ],
  "rls": {
    "read": {},
    "write": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}