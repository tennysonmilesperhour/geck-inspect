{
  "name": "ForumCategory",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the forum category"
    },
    "description": {
      "type": "string",
      "description": "Description of what this category is for"
    },
    "order_position": {
      "type": "number",
      "default": 0,
      "description": "Order position for display"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this category is active"
    }
  },
  "required": [
    "name",
    "description"
  ],
  "rls": {
    "read": {},
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}