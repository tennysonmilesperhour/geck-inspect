{
  "name": "MorphTrait",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "The display name of the trait."
    },
    "category": {
      "type": "string",
      "description": "The group this trait belongs to in the visualizer."
    },
    "type": {
      "type": "string",
      "enum": [
        "single",
        "multiple"
      ],
      "description": "Determines if only one (single) or multiple traits can be selected in this category."
    },
    "imageUrl": {
      "type": "string",
      "description": "URL to the transparent PNG image for this trait overlay."
    },
    "color": {
      "type": "string",
      "description": "Hex color code, used for Base Color traits."
    },
    "zIndex": {
      "type": "number",
      "description": "The layering order for the image overlay. Higher numbers are on top."
    },
    "order": {
      "type": "number",
      "description": "Display order within the category."
    }
  },
  "required": [
    "name",
    "category",
    "type",
    "zIndex"
  ],
  "rls": {
    "read": {},
    "write": {
      "role": "admin"
    },
    "update": {
      "role": "admin"
    },
    "delete": {
      "role": "admin"
    }
  }
}