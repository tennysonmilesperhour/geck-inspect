{
  "name": "AppSettings",
  "type": "object",
  "properties": {
    "setting_key": {
      "type": "string",
      "description": "Unique identifier for the setting (e.g., 'donations_page_content')"
    },
    "setting_value": {
      "type": "string",
      "description": "The value of the setting (can be text, HTML, JSON string, etc.)"
    },
    "description": {
      "type": "string",
      "description": "Description of what this setting controls"
    }
  },
  "required": [
    "setting_key"
  ],
  "rls": {
    "read": {},
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}