{
  "name": "MorphPriceCache",
  "type": "object",
  "properties": {
    "morph_name": {
      "type": "string",
      "description": "The name of the morph (unique key)."
    },
    "low_price": {
      "type": "number",
      "description": "The low-end market price."
    },
    "high_price": {
      "type": "number",
      "description": "The high-end market price."
    },
    "average_price": {
      "type": "number",
      "description": "The average market price."
    },
    "currency": {
      "type": "string",
      "default": "USD",
      "description": "The currency of the price."
    },
    "source": {
      "type": "string",
      "description": "The website source of the data (e.g., MorphMarket)."
    }
  },
  "required": [
    "morph_name",
    "average_price"
  ],
  "rls": {
    "read": {},
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}