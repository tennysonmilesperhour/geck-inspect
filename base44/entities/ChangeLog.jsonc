{
  "name": "ChangeLog",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Short title for this changelog entry"
    },
    "week_label": {
      "type": "string",
      "description": "Week label e.g. 'Week of March 10, 2026'"
    },
    "bullet_points": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of change bullet points in plain language"
    },
    "is_published": {
      "type": "boolean",
      "default": false,
      "description": "Whether this changelog is visible to all users"
    },
    "published_date": {
      "type": "string",
      "format": "date-time",
      "description": "When this was published"
    },
    "raw_notes": {
      "type": "string",
      "description": "Admin's raw notes before AI summarization"
    }
  },
  "required": [
    "title",
    "week_label"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "is_published": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}