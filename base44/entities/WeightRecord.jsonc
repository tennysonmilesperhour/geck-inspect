{
  "name": "WeightRecord",
  "type": "object",
  "properties": {
    "gecko_id": {
      "type": "string",
      "description": "The ID of the gecko this weight record belongs to"
    },
    "weight_grams": {
      "type": "number",
      "description": "The weight of the gecko in grams"
    },
    "record_date": {
      "type": "string",
      "format": "date",
      "description": "The date the weight was recorded"
    }
  },
  "required": [
    "gecko_id",
    "weight_grams",
    "record_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "created_by": "{{user.email}}"
    }
  }
}