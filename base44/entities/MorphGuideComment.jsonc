{
  "name": "MorphGuideComment",
  "type": "object",
  "properties": {
    "morph_guide_id": {
      "type": "string",
      "description": "The ID of the MorphGuide entry this comment is for"
    },
    "user_email": {
      "type": "string",
      "description": "Email of the user who submitted the comment"
    },
    "user_name": {
      "type": "string",
      "description": "Display name of the user"
    },
    "subject": {
      "type": "string",
      "description": "Subject/title of the comment"
    },
    "content": {
      "type": "string",
      "description": "The comment content"
    },
    "image_url": {
      "type": "string",
      "description": "Optional image URL attached to the comment"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "Approval status of the comment"
    },
    "rejection_reason": {
      "type": "string",
      "description": "Reason for rejection, if applicable"
    },
    "is_helpful": {
      "type": "boolean",
      "default": false,
      "description": "Whether admin marked this as particularly helpful"
    }
  },
  "required": [
    "morph_guide_id",
    "user_email",
    "user_name",
    "subject",
    "content"
  ],
  "rls": {
    "read": {},
    "write": {
      "user_email": "{{user.email}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}