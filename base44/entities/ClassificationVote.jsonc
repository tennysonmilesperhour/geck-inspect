{
  "name": "ClassificationVote",
  "type": "object",
  "properties": {
    "gecko_image_id": {
      "type": "string",
      "description": "The ID of the GeckoImage this vote is for."
    },
    "primary_morph": {
      "type": "string",
      "description": "The primary morph voted by the user."
    },
    "secondary_traits": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Secondary traits voted by the user."
    },
    "base_color": {
      "type": "string",
      "description": "The base color voted by the user."
    },
    "notes": {
      "type": "string",
      "description": "Additional notes from the user for this vote."
    },
    "verified": {
      "type": "boolean",
      "default": false,
      "description": "Whether this vote has been verified by an expert."
    },
    "verified_by": {
      "type": "string",
      "description": "Email of the expert who verified this vote."
    }
  },
  "required": [
    "gecko_image_id",
    "primary_morph"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "created_by": "{{user.email}}"
    }
  }
}