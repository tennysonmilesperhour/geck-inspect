{
  "name": "GeckoImage",
  "type": "object",
  "properties": {
    "image_url": {
      "type": "string",
      "description": "URL of the uploaded gecko image"
    },
    "user_id": {
      "type": "string",
      "description": "The ID of the user who created the image"
    },
    "perceptual_hash": {
      "type": "string",
      "description": "AI-generated signature for image similarity detection"
    },
    "primary_morph": {
      "type": "string",
      "enum": [
        "flame",
        "harlequin",
        "extreme_harlequin",
        "pinstripe",
        "phantom_pinstripe",
        "tiger",
        "brindle",
        "extreme_brindle",
        "dalmatian",
        "super_dalmatian",
        "patternless",
        "bicolor",
        "tricolor",
        "lilly_white",
        "axanthic",
        "cappuccino",
        "frappuccino",
        "hypo",
        "translucent",
        "moonglow",
        "red_base",
        "yellow_base",
        "orange_base",
        "olive",
        "chocolate",
        "lavender",
        "red_harlequin",
        "yellow_harlequin",
        "cream_harlequin",
        "buckskin",
        "white_wall",
        "empty_back",
        "soft_scale",
        "super_soft_scale"
      ],
      "description": "Primary morph classification"
    },
    "secondary_morph": {
      "type": "string",
      "enum": [
        "flame",
        "harlequin",
        "extreme_harlequin",
        "pinstripe",
        "phantom_pinstripe",
        "tiger",
        "brindle",
        "extreme_brindle",
        "dalmatian",
        "super_dalmatian",
        "patternless",
        "bicolor",
        "tricolor",
        "lilly_white",
        "axanthic",
        "cappuccino",
        "frappuccino",
        "hypo",
        "translucent",
        "moonglow",
        "red_base",
        "yellow_base",
        "orange_base",
        "olive",
        "chocolate",
        "lavender",
        "red_harlequin",
        "yellow_harlequin",
        "cream_harlequin",
        "buckskin",
        "white_wall",
        "empty_back",
        "soft_scale",
        "super_soft_scale"
      ],
      "description": "Secondary morph classification (optional)"
    },
    "secondary_traits": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "super_stripe",
          "partial_pinstripe",
          "dashed_pinstripe",
          "reverse_pinstripe",
          "phantom",
          "fired_up",
          "fired_down",
          "dalmatian_spots",
          "super_spots",
          "ink_spots",
          "oil_spots",
          "red_spots",
          "portholes",
          "kneecaps",
          "white_tipped_crests",
          "colored_crests",
          "drippy_dorsal",
          "furred_trait",
          "quad_stripe",
          "crowned",
          "white_fringe",
          "side_stripe",
          "tiger_striping",
          "banded",
          "broken_banding",
          "chevron_pattern",
          "diamond_pattern",
          "reticulated",
          "mottled",
          "speckled"
        ]
      },
      "description": "Additional traits visible in the gecko"
    },
    "base_color": {
      "type": "string",
      "enum": [
        "red",
        "dark_red",
        "bright_red",
        "yellow",
        "bright_yellow",
        "pale_yellow",
        "orange",
        "peach",
        "cream",
        "white",
        "brown",
        "dark_brown",
        "tan",
        "olive",
        "dark_olive",
        "buckskin",
        "chocolate",
        "lavender",
        "purple",
        "black",
        "grey",
        "silver"
      ],
      "description": "Base coloration of the gecko"
    },
    "pattern_intensity": {
      "type": "string",
      "enum": [
        "none",
        "low",
        "medium",
        "high",
        "extreme",
        "super"
      ],
      "description": "Intensity of the pattern"
    },
    "white_amount": {
      "type": "string",
      "enum": [
        "none",
        "low",
        "medium",
        "high",
        "extreme"
      ],
      "description": "Amount of white coloration present"
    },
    "confidence_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Confidence level in the classification (0-100)"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes about the gecko"
    },
    "verified": {
      "type": "boolean",
      "default": false,
      "description": "Whether this classification has been verified by an expert"
    },
    "age_estimate": {
      "type": "string",
      "enum": [
        "juvenile",
        "sub_adult",
        "adult",
        "unknown"
      ],
      "description": "Estimated age category of the gecko"
    },
    "fired_state": {
      "type": "string",
      "enum": [
        "fired_up",
        "fired_down",
        "partial",
        "unknown"
      ],
      "description": "Whether the gecko is fired up or down in the image"
    },
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "morph": {
            "type": "string"
          },
          "feature": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "outline",
              "highlight",
              "arrow"
            ]
          },
          "points": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                }
              }
            }
          }
        }
      },
      "description": "Visual annotations highlighting morph features"
    }
  },
  "required": [
    "image_url",
    "primary_morph"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}