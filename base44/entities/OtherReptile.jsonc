{
  "name": "OtherReptile",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "The reptile's name"
    },
    "species": {
      "type": "string",
      "description": "Species of the reptile"
    },
    "morph": {
      "type": "string",
      "description": "Morph or color variation"
    },
    "sex": {
      "type": "string",
      "enum": [
        "Male",
        "Female",
        "Unsexed"
      ],
      "description": "Sex of the reptile"
    },
    "birth_date": {
      "type": "string",
      "format": "date",
      "description": "Birth or acquisition date"
    },
    "notes": {
      "type": "string",
      "description": "General notes"
    },
    "image_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Images of the reptile"
    },
    "feeding_reminder_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether feeding reminders are enabled"
    },
    "feeding_interval_days": {
      "type": "number",
      "default": 7,
      "description": "Days between feedings"
    },
    "last_fed_date": {
      "type": "string",
      "format": "date",
      "description": "Date of last feeding"
    },
    "feeding_notification_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Enable in-app notifications for feeding"
    },
    "feeding_email_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Enable email reminders for feeding"
    },
    "archived": {
      "type": "boolean",
      "default": false,
      "description": "Whether this reptile has been archived"
    },
    "archived_date": {
      "type": "string",
      "format": "date",
      "description": "The date this reptile was archived"
    }
  },
  "required": [
    "name",
    "species"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "created_by": "{{user.email}}"
    }
  }
}