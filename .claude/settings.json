{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read", "Glob", "Grep", "Edit", "Write", "WebSearch", "WebFetch",

      "Bash(pnpm install*)", "Bash(pnpm dev*)", "Bash(pnpm build*)",
      "Bash(pnpm test*)", "Bash(pnpm lint*)", "Bash(pnpm typecheck*)",
      "Bash(pnpm audit*)", "Bash(pnpm check:*)", "Bash(pnpm eval:*)",
      "Bash(pnpm preview*)", "Bash(pnpm exec vitest*)", "Bash(pnpm exec eslint*)",
      "Bash(pnpm exec tsc*)", "Bash(pnpm ls*)",
      "Bash(npx vitest*)", "Bash(npx eslint*)", "Bash(npx tsc*)",
      "Bash(node scripts/build-*)", "Bash(node scripts/check-*)",
      "Bash(node scripts/seo-*)", "Bash(node scripts/prerender.mjs*)",
      "Bash(node scripts/eval-morph-id.mjs*)",

      "Bash(git status*)", "Bash(git diff*)", "Bash(git log*)", "Bash(git show*)",
      "Bash(git branch*)", "Bash(git checkout*)", "Bash(git switch*)",
      "Bash(git add*)", "Bash(git commit*)", "Bash(git fetch*)", "Bash(git pull*)",
      "Bash(git push origin main*)", "Bash(git push -u origin main*)",
      "Bash(git push -u origin claude/*)", "Bash(git stash*)", "Bash(git merge*)",
      "Bash(git reset --hard origin/main*)", "Bash(git rev-parse*)",
      "Bash(git ls-files*)", "Bash(git restore*)",

      "Bash(ls*)", "Bash(cat *)", "Bash(head *)", "Bash(tail *)", "Bash(wc *)",
      "Bash(find *)", "Bash(grep *)", "Bash(rg *)", "Bash(sed -n *)", "Bash(jq *)",
      "Bash(mkdir *)", "Bash(cp *)", "Bash(mv *)",

      "mcp__github__get_file_contents", "mcp__github__get_commit",
      "mcp__github__get_check_run", "mcp__github__get_job_logs",
      "mcp__github__list_branches", "mcp__github__list_commits",
      "mcp__github__list_pull_requests", "mcp__github__pull_request_read",
      "mcp__github__issue_read", "mcp__github__search_code",
      "mcp__github__actions_get", "mcp__github__actions_list",
      "mcp__github__create_pull_request", "mcp__github__update_pull_request",
      "mcp__github__merge_pull_request", "mcp__github__enable_pr_auto_merge",

      "mcp__Supabase__list_tables", "mcp__Supabase__list_migrations",
      "mcp__Supabase__list_edge_functions", "mcp__Supabase__get_advisors",
      "mcp__Supabase__get_project", "mcp__Supabase__query_logs",
      "mcp__Supabase__search_docs",

      "mcp__Vercel__list_deployments", "mcp__Vercel__get_deployment",
      "mcp__Vercel__list_deployment_events", "mcp__Vercel__get_runtime_logs",
      "mcp__Vercel__get_runtime_errors"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(supabase db push*)", "Bash(supabase functions deploy*)",
      "Bash(vercel*)", "Bash(bash scripts/deploy-*)",
      "Bash(node scripts/backfill-*)", "Bash(node scripts/submit-indexnow.mjs*)",
      "Bash(pnpm add*)", "Bash(pnpm remove*)",
      "mcp__Supabase__execute_sql", "mcp__Supabase__apply_migration",
      "mcp__Supabase__deploy_edge_function"
    ],
    "deny": [
      "Read(./.env)", "Read(./.env.local)", "Read(./.env.production*)",
      "Read(./**/keystore.properties)", "Read(./**/*.keystore)",
      "Bash(git push --force*)", "Bash(git push -f*)",
      "Bash(rm -rf /*)", "Bash(rm -rf ~*)", "Bash(sudo *)",
      "mcp__Supabase__create_branch", "mcp__Supabase__delete_branch",
      "mcp__Supabase__reset_branch", "mcp__Supabase__pause_project"
    ]
  }
}
